{
    "name": "chirache.com",
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@tailwindcss/cli": "^4.3.5",
        "@tailwindcss/typography": "^0.5.4",
        "katex": "^0.19.1",
        "tailwindcss": "^4.3.5"
    },
    "scripts": {
        "assets": "bash ./scripts/copy-assets.sh",
        "css": "npx @tailwindcss/cli -i ./theme/input.css -o ./static/tailwind/output.css",
        "prebuild": "npm run assets",
        "build": "npm run css -- --minify --minify && zola build",
        "prewatch": "npm run assets && npm run css",
        "watch": "concurrently --kill-others-on-fail 'npm run css -- --watch' 'zola serve'"
    },
    "devDependencies": {
        "concurrently": "^10.0.7",
        "prettier": "^3.10.1",
        "prettier-plugin-jinja-template": "^2.2.0",
        "prettier-plugin-tailwindcss": "^0.8.1"
    },
    "allowScripts": {
        "@parcel/watcher": true
    }
}
