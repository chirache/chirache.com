{
    "name": "chirache",
    "compatibility_date": "2026-11-22",
    "send_metrics": false,
    "workers_dev": false,
    "preview_urls": false,
    "build": {
        "command": "bash ./scripts/build.sh"
    },
    "assets": {
        "directory": "./public",
        "not_found_handling": "404-page"
    },
    "routes": [
        {
            "pattern": "chirache.com",
            "custom_domain": true
        }
    ]
}
